#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";

            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   | BSPC  |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | RSHIFT|
            // | LSHIFT|  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | LCTRL |  Z  |  X  |  C   |  V   |  B   |        |   |      |  N   |  M    |  ,    |  .   |   /   |  RGUI |
            //                     | LGUI | Layer1  | SPACE|     |   |      |  ENTER | Layer2 | RALT  |

            bindings = <
&kp ESC     &kp N1  &kp N2  &kp N3    &kp N4  &kp N5                     &kp N6     &kp N7  &kp N8     &kp N9   &kp N0    &kp BSPC
&kp TAB     &kp Q   &kp W   &kp E     &kp R   &kp T                      &kp Y      &kp U   &kp I      &kp O    &kp P     &kp RSHIFT
&kp LSHIFT  &kp A   &kp S   &kp D     &kp F   &kp G                      &kp H      &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL   &kp Z   &kp X   &kp C     &kp V   &kp B      &none    &none  &kp N      &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp RGUI
                            &kp LGUI  &mo 1   &kp SPACE  &none    &none  &kp ENTER  &mo 2   &kp RALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_1 {
            display-name = "Lower Layer";

            // ------------------------------------------------------------------------------------------------------------
            // |      |     |     |      |      |      |                   |   \   |   [   |   ]   |      |       |       |
            // |      |     |     |      |      |      |                   |   \   |   [   |   ]   |      |       |       |
            // |      |     |     |      |      |      |                   | RIGHT | DOWN  | UP    | LEFT |       |       |
            // |      |  +  |  -  |   *  |   /  |   =  |        |  |       |      |       |       |      |       |       |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&none      &none     &none      &none         &none      &none                      &none            &none          &none     &none            &none  &kp BACKSPACE
&none      &none     &none      &none         &none      &none                      &kp BSLH         &kp LBKT       &kp RBKT  &none            &none  &none
&kp GRAVE  &none     &none      &none         &none      &none                      &kp LEFT_ARROW   &kp DOWN       &kp UP    &kp RIGHT_ARROW  &none  &none
&kp LCTRL  &kp PLUS  &kp MINUS  &kp ASTERISK  &kp SLASH  &kp EQUAL  &none    &none  &none            &none          &none     &none            &none  &none
                                &none         &none      &none      &none    &none  &kp RIGHT_SHIFT  &kp RIGHT_ALT  &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_2 {
            display-name = "Raise Layer";

            // ------------------------------------------------------------------------------------------------------------
            // |      |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |      |  F1 | F2  |  F3  | F4   |  F5  |                   |      |       |       |      |       |       |
            // |      |  F6 | F7  |  F8  | F9   |  F10 |                   | HOME | PG_DN | PG_UP | END  |       |       |
            // |      | F11 | F12 |      |      |      |        |  |       |      |       |       |      |       |       |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&none  &none    &none    &none   &none   &none                    &none     &none      &none      &none    &none  &none
&none  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5                   &none     &none      &none      &none    &none  &none
&none  &kp F6   &kp F7   &kp F8  &kp F9  &kp F10                  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END  &none  &none
&none  &kp F11  &kp F12  &none   &none   &none    &none    &none  &none     &none      &none      &none    &none  &none
                         &none   &none   &none    &none    &none  &none     &none      &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
